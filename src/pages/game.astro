---
// /game/ → 文章页的跳转。
// prerender = true 让它在纯静态构建下也能产出（Cloudflare / Vercel / GitHub Pages / 本地都能跑），
// 产物是带 meta refresh 的跳转页；Vercel 侧另有 vercel.json 的真实 301 规则。
// 目标用 import.meta.env.BASE_URL 拼接，多平台用不同 base 构建时不会指错。
export const prerender = true;
const target = `${import.meta.env.BASE_URL}posts/game/`.replace(/\/{2,}/g, "/");
return Astro.redirect(target, 301);
---
